{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperFree",
  "identifier": "com.bartek.whisperfree",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "WhisperFree",
        "width": 760,
        "height": 620,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": true,
        "titleBarStyle": "Visible"
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "WhisperFree overlay",
        "width": 224,
        "height": 60,
        "visible": false,
        "focus": false,
        "focusable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
