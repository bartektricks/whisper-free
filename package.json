{
  "name": "whisper-free",
  "version": "0.2.0",
  "description": "Fully local macOS dictation. Press a hotkey, speak, get text.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "dotenv -- tauri",
    "clippy": "cargo clippy --manifest-path ./src-tauri/Cargo.toml",
    "clippy:fix": "cargo clippy --manifest-path ./src-tauri/Cargo.toml --fix"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-os": "^2.3.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@7",
    "dotenv-cli": "^11.0.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "~6",
    "vite": "^8.2.1"
  }
}
